# Base de datos (MySQL)
DATABASE_URL="mysql://usuario:password@localhost:3306/cuanto_toca"

# Clave para firmar los JWT de sesión (HS256). Obligatoria: sin ella el login falla.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL pública de la app; se usa en los enlaces de los correos.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP para el envío de correos (recuperación de contraseña y alta de usuarios)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Cuenta SUPER_ADMIN que crea `npx prisma db seed` (opcional; hay valores por defecto)
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_EMAIL="admin@cuantotoca.app"
SEED_ADMIN_NOMBRE="Super administrador"
# Déjala vacía y el seed genera una aleatoria y la imprime UNA sola vez.
# Nunca pongas aquí una contraseña real: este archivo sí se commitea.
SEED_ADMIN_PASSWORD=""
# Ponla en 1 solo cuando quieras REEMPLAZAR la contraseña de un admin que ya
# existe (por ejemplo si se filtró). Con 0 o sin definir, el seed no la toca.
SEED_ADMIN_ROTAR_PASSWORD="0"

# Login con Google (Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente de OAuth 2.0 > Aplicación web).
# Solo se necesita el Client ID: usamos el flujo de ID token, no el de
# authorization code, así que no hay client secret que guardar.
#   Orígenes de JavaScript autorizados: https://tu-dominio.com
#                                       http://localhost:3000  (desarrollo)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Resend: correo del código de 6 dígitos que se pide al entrar con contraseña.
# El dominio de RESEND_FROM debe estar verificado en Resend.
RESEND_API_KEY=""
RESEND_FROM="Cuánto Toca <no-reply@tu-dominio.com>"
# Llave de apagado. En "false" el login vuelve a ser de un solo paso; úsala si
# Resend se cae para no dejar a nadie fuera de su cuenta.
LOGIN_CODIGO_HABILITADO="true"
